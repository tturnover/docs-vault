# copy to .env and fill in
VAULT_USER=edit
VAULT_PASS=change-me-please
VAULT_DATA=/srv/dev-disk-by-uuid-XXXX/share0/v1
VAULT_PORT=4012
PUID=1000
PGID=100

# reverse proxies (CIDRs, space separated) whose X-Forwarded-For is trusted, e.g. Caddy's address
VAULT_TRUSTED_PROXIES=

# WireGuard VPN (remove the next line to run without VPN)
COMPOSE_PROFILES=vpn
# public name/IP clients connect to, UDP port forwarded on the router to this host
WG_HOST=vault.example.com
WG_PORT=51820
WG_PEERS=phone,laptop
TZ=Europe/Kyiv
